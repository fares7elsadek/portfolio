---
import { Icon } from "astro-icon/components";

const socialLinks: {
	friendlyName: string;
	link: string;
	name: string;
}[] = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/fares7elsadek",
		name: "mdi:github",
	},
	{
		friendlyName: "LinkedIn",
		link: "https://linkedin.com/in/fares-elsadek",
		name: "mdi:linkedin",
	},
	{
		friendlyName: "Medium",
		link: "https://medium.com/@fares7elsadek",
		name: "mdi:notebook-edit-outline",
	},
	{
		friendlyName: "Email",
		link: "mailto:fares7elsadek@gmail.com",
		name: "mdi:email-outline",
	},
];
---

<div class="flex flex-wrap items-center gap-x-4">
	<ul class="flex items-center gap-x-4">
		{
			socialLinks.map(({ friendlyName, link, name }) => (
				<li class="flex">
					<a
						class="hover:text-link inline-block transition-colors"
						href={link}
						rel="noreferrer"
						target="_blank"
					>
						<Icon aria-hidden="true" class="h-7 w-7" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
