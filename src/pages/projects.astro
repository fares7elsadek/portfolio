---
import { featuredProjects, otherProjects } from "@/data/portfolio";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	title: "Projects",
	description:
		"Backend engineering projects featuring .NET, Go, Spring Boot, distributed systems, Kubernetes, and observability.",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-8 text-2xl">Projects</h1>

	{/* ── Featured Projects ──────────────────────── */}
	<section>
		<h2 class="title mb-6 text-xl">Featured</h2>
		<div class="space-y-10">
			{featuredProjects.map((project) => (
				<article class="rounded-md border border-current/10 p-5">
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
						<h3 class="text-accent-2 text-lg font-semibold">{project.name}</h3>
						<a
							href={project.github}
							target="_blank"
							rel="noreferrer"
							class="cactus-link text-sm"
						>
							View on GitHub →
						</a>
					</div>
					<p class="mt-2 mb-3">{project.description}</p>
					<div class="mb-4 flex flex-wrap gap-1.5">
						{project.tech.map((t) => (
							<span class="bg-global-text/8 text-muted rounded px-2 py-0.5 text-xs font-medium">
								{t}
							</span>
						))}
					</div>
					<ul class="list-inside list-disc space-y-1.5 text-sm" role="list">
						{project.highlights.map((h) => (
							<li>{h}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>

	{/* ── Other Projects ──────────────────────────── */}
	<section class="mt-16">
		<h2 class="title mb-6 text-xl">Other Projects</h2>
		<div class="space-y-6">
			{otherProjects.map((project) => (
				<article class="rounded-md border border-current/10 p-4">
					<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
						<h3 class="text-accent-2 font-semibold">{project.name}</h3>
						<a
							href={project.github}
							target="_blank"
							rel="noreferrer"
							class="cactus-link text-sm"
						>
							GitHub →
						</a>
					</div>
					<p class="text-muted mt-1 mb-2 text-sm">{project.description}</p>
					<div class="mb-3 flex flex-wrap gap-1.5">
						{project.tech.map((t) => (
							<span class="bg-global-text/8 text-muted rounded px-2 py-0.5 text-xs font-medium">
								{t}
							</span>
						))}
					</div>
					<ul class="list-inside list-disc space-y-1 text-sm" role="list">
						{project.highlights.map((h) => (
							<li>{h}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</section>
</PageLayout>
